<!-- 將以下 key 加入 ios/Runner/Info.plist 嘅 <dict> 入面 -->

<!-- 咪高峰權限（必須，否則錄音會 crash） -->
<key>NSMicrophoneUsageDescription</key>
<string>CareMate 需要使用咪高峰，等你可以用把聲同 CareMate 傾偈。</string>

<!-- 只限開發階段：容許用 http:// 連本機伺服器。用 cloudflared https 網址就唔需要 -->
<key>NSAppTransportSecurity</key>
<dict>
  <key>NSAllowsArbitraryLoads</key>
  <true/>
</dict>
<!-- 連同一 Wi-Fi 入面嘅 Mac 時，iOS 會問「本地網絡」權限 -->
<key>NSLocalNetworkUsageDescription</key>
<string>CareMate 需要連接同一網絡入面嘅開發伺服器。</string>
